# Variables de referencia; el servidor las lee del entorno del proceso.
# Este archivo no se carga automáticamente.
PORT=3000
HOST=0.0.0.0
# Orígenes públicos adicionales del cliente, separados por comas y sin barra final.
# FRONTEND_ORIGINS=https://virus-laboratorio.s3.us-east-1.amazonaws.com
# Solo para npm run build:client; direcciones públicas, sin secretos.
# API_BASE_URL=https://juego.example.com
# WS_URL=wss://juego.example.com
# ADMIN_URL=https://juego.example.com/admin
# Solo con Node inaccesible directamente y detrás de un proxy que sanea X-Forwarded-*.
# TRUST_PROXY=true
MAX_PLAYERS=8
MAX_ROOMS=500
STATE_FILE=./data/rooms.json
DB_FILE=./data/virus.sqlite
# Configura tu propia contraseña (12–256 caracteres) o deja ADMIN_PASSWORD sin definir.
# ADMIN_PASSWORD=elige-una-contraseña-larga
TURN_TIMEOUT_MS=25000
REMATCH_TIMEOUT_MS=90000
DISCONNECT_TIMEOUT_MS=300000
